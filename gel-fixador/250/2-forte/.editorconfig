[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
indent_style = space
indent_size = 4

[{*.sht, *.html, *.shtm, *.shtml, *.htm}]
indent_size = 2

[{composer.lock, .babelrc, .stylelintrc, .eslintrc, jest.config, *.json, *.jsb3, *.jsb2, *.bowerrc}]
indent_size = 2

[*.css]
indent_size = 2

[*.less]
indent_size = 2

[*.scss]
indent_size = 2

[*.js.map]
indent_size = 2

[{*.yml, *.yaml}]
indent_size = 2